# Copie ce fichier en .env (local) et renseigne les mêmes variables dans
# Vercel → Project Settings → Environment Variables pour la production.
# Ne jamais committer .env avec de vraies valeurs (déjà exclu par .gitignore).

# --- Base de données (Postgres / Neon) ---------------------------------
# Les deux chaînes viennent de Vercel → Storage → ta base → onglet
# ".env.local" : DATABASE_URL est la connexion "pooled" (via pgbouncer,
# utilisée à l'exécution), DATABASE_URL_UNPOOLED la connexion directe
# (utilisée uniquement par Prisma pour les migrations — voir schema.prisma).
DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://..."

# --- Authentification (NextAuth v5) ------------------------------------
# Clé de signature des sessions — générée une fois avec :
#   npx auth secret
# Une valeur différente en local et en production est normal (et recommandé).
AUTH_SECRET=""
# URL publique de l'appli en production (pas nécessaire en local, next dev
# la déduit tout seul). Ex : https://dtoalpinesflight.com
AUTH_URL=""

# --- Email (Resend, via son relais SMTP) --------------------------------
# Utilisé pour : bienvenue élève, réservation/annulation/rappel de vol,
# relance licences, notification de nouveau document. Sans ces variables,
# l'appli compose les emails mais ne les envoie pas — reste utilisable
# normalement (aucune fonctionnalité ne dépend strictement de l'envoi).
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASS="re_..."
MAIL_FROM="Alpines Flight <no-reply@dtoalpinesflight.com>"

# --- Rappels planifiés (Vercel Cron) -------------------------------------
# Protège /api/cron/reminders : Vercel envoie ce jeton dans l'en-tête
# Authorization à chaque déclenchement planifié (voir vercel.json). Générée
# avec : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# --- Import des programmes de formation (local uniquement) -------------
# Chemin vers le dossier des fichiers JSON des livrets DTO sur TA machine.
# Sans objet en production : les programmes sont importés une fois en
# local puis migrés avec le reste des données (voir le guide de mise en ligne).
TRAINING_PROGRAMS_DIR=""
